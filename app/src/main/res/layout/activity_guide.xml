<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Channel info, top left -->
    <LinearLayout
        android:id="@+id/info"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:focusable="true"
                android:maxWidth="300dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="16dp"
                android:paddingTop="5dp"
                android:paddingEnd="16dp"
                android:paddingBottom="5dp"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <!-- Search: OK opens the Fire TV keyboard; the list filters as you type -->
            <EditText
                android:id="@+id/search"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/fg"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/fg"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/infoQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/infoFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:textColor="@color/focus"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#C6D3DC"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Channel list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="44dp"
        android:layout_marginTop="262dp"
        android:layout_marginEnd="44dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="16dp" />

    <!-- Big letter shown briefly when jumping by letter (Rewind / Fast-forward) -->
    <TextView
        android:id="@+id/letter"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/focus"
        android:textSize="64sp"
        android:visibility="gone" />

    <!-- Video: preview box top right, or full screen -->
    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="400dp"
        android:layout_height="225dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_video">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:resize_mode="fit"
            app:shutter_background_color="#000000"
            app:use_controller="false" />

        <LinearLayout
            android:id="@+id/videoMsgBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/videoSpinner"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/focus"
                android:visibility="gone" />

            <TextView
                android:id="@+id/videoMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Full-screen banner -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/bannerLogo"
                android:layout_width="72dp"
                android:layout_height="72dp">
                <include layout="@layout/view_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/bannerMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#C7D3DC"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
