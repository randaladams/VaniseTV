<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VaniseTV" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>
    <style name="Dialog.VaniseTV" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>
</resources>
